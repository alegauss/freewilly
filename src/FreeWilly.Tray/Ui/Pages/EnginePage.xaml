<!-- What the engine did, and what this machine saw it do (DD165). A destination and not a second
     window (L2): the log is not the only thing somebody wants at the moment they open this — how
     many times the engine has been brought back, and where the file is so it can go into a bug
     report, are the other two, and a window titled after a log can only hold the log.

     The log pane is LogWindow's, deliberately: monospace because a stamped column that does not line
     up is a column nobody can scan, Follow on by default because a page opened on a machine that is
     misbehaving is opened to watch it, and Copy all because the next thing a developer does with
     this is paste it somewhere. Two views of the same kind of thing that looked unrelated would read
     as two unfinished apps. -->
<UserControl x:Class="FreeWilly.Tray.Ui.Pages.EnginePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:FreeWilly.Tray.Ui"
             x:ClassModifier="internal">
  <Grid Margin="10,10,10,10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /><!-- what it adds up to, and the two controls -->
      <RowDefinition Height="Auto" /><!-- what state the machine under the engine is in (DD197) -->
      <RowDefinition Height="Auto" /><!-- where the file is -->
      <RowDefinition Height="*" />   <!-- the journal itself -->
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,8">
      <!-- The restart count is the number this page exists to put in front of somebody: a machine
           brought back four times overnight and one that never lost the engine look identical the
           morning after, and that was as true of a file nobody opened as of the console it
           replaced. -->
      <TextBlock x:Name="Digest" FontSize="14" VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <CheckBox x:Name="Follow" Content="Follow" IsChecked="True"
                  VerticalAlignment="Center"
                  Checked="FollowChanged" Unchecked="FollowChanged" />
        <Button x:Name="CopyAll" Content="Copy all" Click="CopyEverything"
                Padding="12,4" Margin="8,0,0,0" FontSize="12" />
      </StackPanel>
    </Grid>

    <!-- The six readings diagnosing the 29 August 2026 failure took by hand (DD197). Above the
         journal because they are the state and the journal is the history, and somebody opening this
         page because the engine will not start wants the state first. Read once when the page is
         shown rather than on the journal's timer: every one of these is a wsl.exe child or a pipe
         request, and DD137's rule is that nothing asks the engine a question on a clock. -->
    <Border Grid.Row="1" x:Name="MachinePane" Margin="0,0,0,8" CornerRadius="6" Padding="10,8"
            Background="{DynamicResource LayerFillColorDefaultBrush}"
            BorderThickness="1"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" /><!-- what a check found (DD199) -->
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,6">
          <TextBlock x:Name="MachineHeading" FontSize="12" VerticalAlignment="Center"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          <!-- The point of the panel is handing what it says to somebody else, so its own copy is
               beside it rather than folded into the journal's: the two answer different questions
               and a reader asked for one does not want the other. -->
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <!-- The control belongs here because the engine is down for the duration and this is
                 the page where that state is already on screen (DD199). Check reads and Repair
                 writes, so only the second asks first — and Repair stays hidden until a check has
                 found something for it to do, which is the design's rule that nobody approves a
                 write before seeing what it is for. -->
            <Button x:Name="Repair" Content="Repair" Click="RepairTheFilesystem"
                    Visibility="Collapsed" Padding="12,2" Margin="0,0,8,0" FontSize="12" />
            <Button x:Name="Check" Content="Check filesystem" Click="CheckTheFilesystem"
                    Padding="12,2" Margin="0,0,8,0" FontSize="12" />
            <Button x:Name="CopyMachine" Content="Copy" Click="CopyTheMachine"
                    Padding="12,2" FontSize="12" />
          </StackPanel>
        </Grid>

        <!-- One column per group, because five short lists side by side is a shape the eye reads in
             one pass and a single column of eighteen rows is not. A WrapPanel and not a UniformGrid:
             the groups are nothing like the same width — the mount options are fifty characters and
             the error counts are one — so equal columns truncate the longest and leave the shortest
             mostly empty. Wrapping is also what a narrow window needs, since these fold onto a
             second line rather than running off the edge. -->
        <ItemsControl Grid.Row="1" x:Name="Machine">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,0,32,6">
                <TextBlock Text="{Binding Title}" FontSize="11" Margin="0,0,0,3"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <ItemsControl ItemsSource="{Binding Readings}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <!-- The name in tertiary and the value in primary, the same split the journal
                           uses for its stamp and its sentence, so the page reads as one thing. The
                           name column is wide enough for the longest of them and carries its own
                           gap: at 86 the words ran into their values with nothing between. -->
                      <StackPanel Orientation="Horizontal" Margin="0,0,0,1">
                        <TextBlock Text="{Binding Name}" FontSize="11" Width="104"
                                   Margin="0,0,10,0" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="{Binding Value}" FontSize="11"
                                   FontFamily="Cascadia Mono, Consolas, Courier New"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!-- What the check found, kept out of the way until there is any. Selectable and monospace
             for the reason the journal is: the next thing done with an e2fsck transcript is pasting
             it somewhere. -->
        <StackPanel Grid.Row="2" x:Name="Found" Visibility="Collapsed" Margin="0,8,0,0">
          <TextBlock x:Name="FoundHeadline" FontSize="12"
                     Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
          <TextBlock x:Name="FoundDetail" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          <TextBox x:Name="FoundSteps" Margin="0,6,0,0" MaxHeight="150"
                   IsReadOnly="True" BorderThickness="0" Background="Transparent"
                   Padding="0" FontSize="11" TextWrapping="NoWrap"
                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                   FontFamily="Cascadia Mono, Consolas, Courier New"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Selectable, and that is the point of it being here rather than in a tooltip: somebody
         attaching this to a bug report needs the path in their clipboard, not read out to them. -->
    <TextBox Grid.Row="2" x:Name="Where" Margin="0,0,0,8"
             IsReadOnly="True" BorderThickness="0" Background="Transparent"
             Padding="0" FontSize="12"
             FontFamily="Cascadia Mono, Consolas, Courier New"
             Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

    <Border Grid.Row="3" x:Name="LogPane" CornerRadius="6" Padding="2"
            Background="{DynamicResource LayerFillColorDefaultBrush}"
            BorderThickness="1"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
      <ListBox x:Name="Lines" BorderThickness="0" Background="Transparent"
               FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="12"
               ScrollViewer.HorizontalScrollBarVisibility="Auto"
               VirtualizingStackPanel.IsVirtualizing="True"
               VirtualizingStackPanel.VirtualizationMode="Recycling">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <!-- The stamp in tertiary and the sentence in primary, because the eye runs down the
                 clock column looking for a gap and reads the sentences either side of it. Shape and
                 not colour carries which kind of line this is (L8) — the word in the second column
                 already says host, power, tray or a state. -->
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Stamp}" TextWrapping="NoWrap"
                         Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
              <TextBlock Text="{Binding Said}" TextWrapping="NoWrap" Margin="8,0,0,0"
                         Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <!-- Designed, like the log window's. A machine whose engine has never been troubled leaves no
         file at all — DD137 made that deliberate — and a blank box says neither that nor "this
         could not be read", which are different answers to be looking at. -->
    <StackPanel Grid.Row="3" x:Name="Empty" VerticalAlignment="Center"
                HorizontalAlignment="Center" Visibility="Collapsed">
      <TextBlock x:Name="EmptyHeadline" FontSize="16" HorizontalAlignment="Center"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
      <TextBlock x:Name="EmptyDetail" Margin="0,6,0,0" FontSize="12" MaxWidth="440"
                 HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
    </StackPanel>
  </Grid>
</UserControl>
