<!-- The containers list, which is what the window is opened for. Its header, its rows, its four
     verbs and its two empty states, and nothing about the engine banner or the strip above it: the
     shell owns the chrome and a list owns its page (DD35).

     The styles it draws with stay in MainWindow.Resources and are reached with DynamicResource, not
     StaticResource. That is not a preference: a StaticResource is resolved while this control is
     parsed, when it is not yet in the window's tree, and the Fluent Button these are BasedOn lives in
     the WINDOW's resources because ThemeMode puts it there (DD34). -->
<UserControl x:Class="FreeWilly.Tray.Ui.Pages.ContainersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:FreeWilly.Tray.Ui"
             x:ClassModifier="internal">

    <UserControl.Resources>
        <!-- These two live here rather than in the shell, and BasedOn is why: it is a CLR property,
             not a DependencyProperty, so a DynamicResource on it is illegal — and WPF says so at
             RENDER time, on the first row measured, not at parse time. Moving them to the page that
             uses them makes a StaticResource correct again, because they are resolved inside the
             file that declares them.

             Neither is BasedOn the Fluent Button, so neither has the problem that keeps RowAction in
             the window (DD34). -->
        <Style x:Key="PortLink" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Hit" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hit" Property="Background"
                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PortText" TargetType="TextBlock">
            <Setter Property="Margin" Value="6,2,6,2" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>
    </UserControl.Resources>
<Grid Margin="0,10,0,0">
  <Grid.RowDefinitions>
    <RowDefinition Height="Auto" /><!-- the filter -->
    <RowDefinition Height="Auto" /><!-- the headings -->
    <RowDefinition Height="*" />   <!-- the rows -->
  </Grid.RowDefinitions>

  <!-- One box, over the rows already in hand. Never a second call to the daemon: every field it
       matches is on the row, and asking the engine to search would be a round trip to answer a
       question this window can answer itself. -->
  <Grid Grid.Row="0" Margin="10,0,10,10">
    <TextBox x:Name="Filter" HorizontalAlignment="Right" Style="{DynamicResource FilterBox}"
             TextChanged="FilterChanged"
             ToolTip="Narrow by name, image, state or port" />
  </Grid>

        <Grid Grid.Row="1" x:Name="HeaderRow" Margin="10,0,10,6">
<Grid.ColumnDefinitions>
    <ColumnDefinition Width="1.2*" />
    <ColumnDefinition Width="1.3*" />
    <ColumnDefinition Width="0.7*" />
    <ColumnDefinition Width="1.1*" />
    <ColumnDefinition Width="1.2*" />
    <ColumnDefinition Width="180" />
</Grid.ColumnDefinitions>
<Button Grid.Column="0" Tag="NAME" Click="SortBy"
        Style="{DynamicResource SortHeading}"
        Content="NAME" x:Name="NameHeading" />
<Button Grid.Column="1" Tag="IMAGE" Click="SortBy"
        Style="{DynamicResource SortHeading}"
        Content="IMAGE" x:Name="ImageHeading" />
<Button Grid.Column="2" Tag="STATE" Click="SortBy"
        Style="{DynamicResource SortHeading}"
        Content="STATE" x:Name="StateHeading" />
<Button Grid.Column="3" Tag="STATUS" Click="SortBy"
        Style="{DynamicResource SortHeading}"
        Content="STATUS" x:Name="StatusHeading" />
<Button Grid.Column="4" Tag="PORTS" Click="SortBy"
        Style="{DynamicResource SortHeading}"
        Content="PORTS" x:Name="PortsHeading" />
        </Grid>

        <ListView Grid.Row="2" x:Name="Containers" BorderThickness="0"
      Background="Transparent"
      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
<ListView.ItemContainerStyle>
    <Style TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="10,8" />
    </Style>
</ListView.ItemContainerStyle>
<ListView.ItemTemplate>
    <DataTemplate>
      <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Character for character the same as HeaderRow's, and a test asserts
                     it: a header whose columns have drifted from the rows under it puts
                     every caption over the wrong cell, and nothing but looking at the
                     window says so. -->
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="1.3*" />
                <ColumnDefinition Width="0.7*" />
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="180" />
            </Grid.ColumnDefinitions>
            <!-- DD106. The indent is on this cell rather than on the whole row: pushing the grid in
                 would take every other column with it, and a STATE cell that no longer sits under
                 the STATE caption is the one thing L3 is about. A DockPanel rather than a nested
                 Grid — nesting one would add a third ColumnDefinitions block to this file and the
                 guard that pairs a header with its rows counts them. -->
            <DockPanel Grid.Column="0" Margin="{Binding Indent}" LastChildFill="True">
                <!-- The affordance: a row that opens into containers and one that does not must not
                     look the same. The glyph pair and the font are claude-tray's, because that
                     window is this project's reference and a second vocabulary reads as a second
                     application. -->
                <TextBlock DockPanel.Dock="Left" Text="{Binding Chevron}"
                           FontFamily="Segoe MDL2 Assets" FontSize="9" Margin="0,1,8,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Visibility="{Binding IsProject, Converter={StaticResource Shown}}" />
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </DockPanel>
            <!-- DD167. A second Run rather than a second element: the note has to sit against the
                 image it is about, and anything laid out across the cell puts it at the far edge
                 where it reads as belonging to the STATE chip next door — seen by capturing it.
                 A Run also needs no panel, so this cell stays one TextBlock and the file keeps the
                 single ColumnDefinitions block the header-and-rows guard pairs.

                 Tertiary and in no warning colour: an image rebuilt under a running container is a
                 condition and not a failure, and Danger is spoken for by the line the daemon's own
                 refusals land on. Empty on every other row, so it costs nothing to draw. The
                 tooltip carries what to do, because the reflex this provokes — restart it — is the
                 one thing that does not work. -->
            <TextBlock Grid.Column="1" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Visibility="{Binding IsContainer, Converter={StaticResource Shown}}"><Run
                       Text="{Binding Image, Mode=OneWay}" /> <Run
                       Text="{Binding ImageNote, Mode=OneWay}" FontSize="11"
                       ToolTip="{Binding ImageEvidence}"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" /></TextBlock>
            <!-- A chip, because state is the column actually scanned and it used to be drawn in
                 the same tertiary grey as the status restating it. The fill is translucent so one
                 pair of bytes works on both surfaces, and it is resolved once per render rather
                 than per row (Ui/RowStyle.cs). A chip is an assertion, so it carries the evidence
                 for itself in its tooltip — and the evidence is more than the status column already
                 shows, or the tooltip would be the same sentence twice. -->
            <Border Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center"
                    CornerRadius="5" Padding="8,2" Background="{Binding ChipFill}"
                    ToolTip="{Binding StateEvidence}"
                    Visibility="{Binding IsContainer, Converter={StaticResource Shown}}">
                <TextBlock Text="{Binding State}" FontSize="12"
                           Foreground="{Binding ChipText}" />
            </Border>
            <TextBlock Grid.Column="3" Text="{Binding Status}" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Visibility="{Binding IsContainer, Converter={StaticResource Shown}}" />
            <!-- What a project says instead of a status, in the column that already carries the
                 sentence. Of the containers under it and not of the project as the daemon knows it:
                 the filter can hide some, and a count a reader cannot check against what is on
                 screen is worse than none. -->
            <TextBlock Grid.Column="3" Text="{Binding ProjectCount}" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Visibility="{Binding IsProject, Converter={StaticResource Shown}}" />
            <ItemsControl Grid.Column="4" ItemsSource="{Binding Ports}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- One of the two shows. A DataTrigger rather than a converter:
                             the whole condition is IsLink, and a converter class would
                             be a file to explain that. -->
                        <Grid>
                            <Button Content="{Binding Text}" Tag="{Binding Url}"
                                    Click="OpenPort" ToolTip="{Binding Url}">
                                <Button.Style>
                                    <Style TargetType="Button"
                                           BasedOn="{StaticResource PortLink}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLink}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <TextBlock Text="{Binding Text}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource PortText}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLink}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- The four verbs, or the one word that says the click landed. Optimistic:
                 the row goes pending on press and the event stream is what takes it
                 back out, because a stop can take the daemon's full ten seconds. -->
            <StackPanel Grid.Column="5" Orientation="Horizontal">
                <!-- First, and offered in every state including pending: the log is the
                     one artefact a container that exited two seconds in leaves, and
                     reading it changes nothing that could be in flight. -->
                <Button Content="Logs" Tag="{Binding}" Click="OpenLogs"
                        Style="{DynamicResource RowAction}"
                        Visibility="{Binding LogsVisibility}" />
                <!-- The one verb this row is opened for: a running container to be stopped, a
                     stopped one to be started. The other three are one click deeper. -->
                <Button Content="{Binding PrimaryVerb}" Tag="{Binding}" Click="PrimaryAction"
                        Style="{DynamicResource RowAction}"
                        Visibility="{Binding HasPrimary, Converter={StaticResource Shown}}" />
                <!-- Always drawn, never revealed on hover: the section is explicit that hiding a
                     verb costs a discovery problem, and a button nobody can see is a verb nobody
                     finds. One click deeper is not the same as hidden. -->
                <Button Content="⋯" Click="OpenOverflow" Tag="{Binding}"
                        Style="{DynamicResource RowAction}"
                        ToolTip="Shell, restart and remove"
                        Visibility="{Binding CanRemove, Converter={StaticResource Shown}}">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <!-- Disabled rather than absent, because "you cannot do this yet" and
                                 "this does not exist" are different answers and only the tooltip
                                 tells them apart. It has more room here than on a cramped button. -->
                            <MenuItem Header="Shell" Click="OpenShell" Tag="{Binding}"
                                      IsEnabled="{Binding CanShell}"
                                      ToolTip="{Binding ShellReason}" />
                            <MenuItem Header="Restart" Click="RestartContainer" Tag="{Binding}"
                                      IsEnabled="{Binding CanRestart}" />
                            <Separator />
                            <MenuItem Header="Remove…" Click="RemoveContainer" Tag="{Binding}"
                                      IsEnabled="{Binding CanRemove}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <TextBlock Text="{Binding Pending}" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Visibility="{Binding IsPending, Converter={StaticResource Shown}}" />
            </StackPanel>

            <!-- The header's hit target, and the last child of the grid so it sits over the cells it
                 covers. Collapsed on a container, which is the trigger — so it catches nothing on a
                 row that has its own buttons. The whole strip rather than the chevron alone: a
                 nine-pixel glyph is a target somebody has to aim at, and the row already reads as
                 one thing. Verbs on a project are DD107; this only folds it away.

                 Both alignments are stated, and they are the whole of DD127: the Fluent Button style
                 sets Left and Center, a templated Border with no child measures to nothing, and a
                 hit target arranged at 0x0 catches no click at all — so the header looked like it
                 folded and never did. Stated locally because a local value is what beats a style. -->
            <Button Grid.Column="0" Grid.ColumnSpan="5" Tag="{Binding}" Click="ToggleProject"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                    ToolTip="Show or hide this project's containers"
                    Visibility="{Binding IsProject, Converter={StaticResource Shown}}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- Where the click was, in the engine's own words. A port already in use or a
             volume still mounted is an ordinary answer, and the daemon says it better
             than any paraphrase this tool could write. -->
        <TextBlock Text="{Binding Failure}" Margin="0,4,0,0" TextWrapping="Wrap"
                   FontSize="12" Foreground="{x:Static ui:Palette.DangerBrush}"
                   Visibility="{Binding HasFailure, Converter={StaticResource Shown}}" />
      </StackPanel>
    </DataTemplate>
</ListView.ItemTemplate>
        </ListView>

        <!-- Empty is designed, not a blank grid: the two reasons a list is empty read differently,
 and only one of them is something the user can do anything about. -->
        <StackPanel Grid.Row="2" x:Name="Empty" VerticalAlignment="Center"
        HorizontalAlignment="Center" Visibility="Collapsed">
<TextBlock x:Name="EmptyHeadline" FontSize="20" HorizontalAlignment="Center"
           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
<TextBlock x:Name="EmptyDetail" Margin="0,8,0,0" FontSize="13"
           HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="420"
           TextWrapping="Wrap"
           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
<Button x:Name="EmptyStart" Content="Start the engine" Margin="0,18,0,0"
        Padding="18,8" HorizontalAlignment="Center" Visibility="Collapsed"
        Click="StartEngine" />
        </StackPanel>
</Grid>
</UserControl>
