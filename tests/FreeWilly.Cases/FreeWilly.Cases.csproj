<Project Sdk="Microsoft.NET.Sdk">

  <!-- WW87. The runner for what scripts\page-probe.ps1 used to do, and deliberately almost nothing
       of its own: the checks live in the engine and this project is what points them at this
       installer's page.

       It is NOT in FreeWilly.slnx, and that is the whole of how it stays apart from the suite.
       `dotnet test` at the root runs the solution, and this needs something a solution cannot
       promise - ISCC on the PATH to compile a real Setup with. So it is driven by run-cases.cmd,
       which is the one command a person types, and by the check.yml step that follows the one
       putting Inno Setup there.

       One package reference and no path into the engine's source. The engine comes from nuget.org
       the same way any adopter's would, which is what makes this project evidence about the
       published package rather than about a checkout beside it. -->
  <PropertyGroup>
    <RootNamespace>FreeWilly.Cases</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Winwright" Version="0.1.0-alpha.5" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

</Project>
